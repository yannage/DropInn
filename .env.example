# Vite development defaults to an isolated local command server.
# Set DROPINN_BACKEND=supabase to test the hosted persistence path locally.
DROPINN_BACKEND=local

# Optional local creative interpretation. "none" keeps all play authored.
DROPINN_AI_PROVIDER=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# Hosted pilot: set these in Netlify, never commit their values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
