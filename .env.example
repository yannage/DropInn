# Vite development defaults to an isolated local command server.
# Set DROPINN_BACKEND=supabase to test the hosted persistence path locally.
DROPINN_BACKEND=local

# Optional local creative interpretation. "none" keeps all play authored.
DROPINN_AI_PROVIDER=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# Hosted pilot: set these in Netlify, never commit their values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Enable each only after its live provider and callback/delivery checks pass.
DROPINN_GOOGLE_AUTH_ENABLED=0
DROPINN_EMAIL_AUTH_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional Paddle checkout. Set the environment explicitly to sandbox or production.
# Keep sales disabled until the matching account, domain, and webhook are ready.
# These are server variables, never VITE secrets.
PADDLE_ENVIRONMENT=
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_SUPPORTER_PRICE_ID=
# Separate live account values let the public sandbox checkout stay unchanged.
# Production uses these values only when PADDLE_ENVIRONMENT=production, except
# the dedicated live webhook, which always verifies against them.
PADDLE_LIVE_API_KEY=
PADDLE_LIVE_CLIENT_TOKEN=
PADDLE_LIVE_WEBHOOK_SECRET=
PADDLE_LIVE_SUPPORTER_PRICE_ID=
PADDLE_LIVE_LAUNCH_DISCOUNT_ID=
PADDLE_LIVE_LAUNCH_STARTS_AT=
PADDLE_LIVE_LAUNCH_ENDS_AT=
# Optional 50% launch offer. Set all three together at live launch; the dates
# must span at most seven days, and Paddle's coupon expiry must equal ENDS_AT.
PADDLE_LAUNCH_DISCOUNT_ID=
PADDLE_LAUNCH_STARTS_AT=
PADDLE_LAUNCH_ENDS_AT=
DROPINN_PAYMENTS_ENABLED=0
